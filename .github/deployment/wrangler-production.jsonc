{
  "name": "beeui",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "beeui.beemvp.com",
      "custom_domain": true
    }
  ]
}
