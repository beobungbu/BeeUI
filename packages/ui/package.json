{
  "name": "@beeui/ui",
  "version": "0.1.0",
  "description": "Typed React Native + Web components built on @beeui/core and @beeui/tokens, styled through Uniwind/Tailwind.",
  "license": "MIT",
  "author": {
    "name": "Trần Đức Lân",
    "email": "lantranduc@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beobungbu/BeeUI.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/beobungbu/BeeUI#readme",
  "bugs": {
    "url": "https://github.com/beobungbu/BeeUI/issues"
  },
  "keywords": [
    "beeui",
    "react-native",
    "react",
    "ui",
    "components",
    "design-system"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/module/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./dist/module/index.js",
      "import": {
        "types": "./dist/typescript/module/index.d.ts",
        "default": "./dist/module/index.js"
      },
      "require": {
        "types": "./dist/typescript/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      },
      "browser": "./dist/module/index.js",
      "default": "./dist/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bob build && node scripts/copy-type-shims.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "dependencies": {
    "@beeui/core": "workspace:*",
    "@beeui/tokens": "workspace:*",
    "class-variance-authority": "0.7.1"
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@types/react-dom": "19.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-teleport": "1.1.13",
    "react-native-worklets": "0.10.1"
  },
  "peerDependencies": {
    "@gorhom/bottom-sheet": ">=5.2 <6",
    "@react-native-community/datetimepicker": ">=9.1 <10",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "react-native": ">=0.86.0 <0.87.0",
    "react-native-gesture-handler": ">=2.32 <3",
    "react-native-reanimated": ">=4.5 <5",
    "react-native-safe-area-context": ">=5 <6",
    "react-native-teleport": ">=1.1 <2",
    "react-native-worklets": ">=0.10 <1",
    "tailwindcss": ">=4 <5",
    "uniwind": ">=1.10.1 <2"
  },
  "peerDependenciesMeta": {
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "@react-native-community/datetimepicker": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  }
}
