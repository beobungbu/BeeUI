{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "BeeUI runtime theme resolver",
  "version": "2025.10",
  "description": "DTCG 2025.10 resolver document for BeeUI foundation tokens and registered Uniwind runtime theme contexts.",
  "sets": {
    "foundation": {
      "description": "BeeUI non-color foundation token groups.",
      "sources": [
        {
          "$ref": "../tokens.json#/tokens"
        }
      ]
    }
  },
  "modifiers": {
    "runtimeTheme": {
      "description": "Selects one complete BeeUI semantic-color runtime theme.",
      "contexts": {
        "light": [
          {
            "$ref": "../tokens.json#/themes/light/colors"
          }
        ],
        "dark": [
          {
            "$ref": "../tokens.json#/themes/dark/colors"
          }
        ],
        "violet-light": [
          {
            "$ref": "../tokens.json#/themes/violet-light/colors"
          }
        ],
        "violet-dark": [
          {
            "$ref": "../tokens.json#/themes/violet-dark/colors"
          }
        ]
      },
      "default": "light",
      "$extensions": {
        "com.beeui": {
          "runtimeThemeByBrand": {
            "bee": {
              "light": "light",
              "dark": "dark"
            },
            "violet": {
              "light": "violet-light",
              "dark": "violet-dark"
            }
          }
        }
      }
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/foundation"
    },
    {
      "$ref": "#/modifiers/runtimeTheme"
    }
  ]
}
