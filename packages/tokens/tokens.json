{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Canonical BeeUI design-token source. Values in generated TypeScript and CSS artifacts must originate here.",
  "metadata": {
    "cssPixelReference": 16,
    "themeNames": ["light", "dark"],
    "brandNames": ["bee", "violet"],
    "runtimeThemeNames": ["light", "dark", "violet-light", "violet-dark"],
    "runtimeThemeByBrand": {
      "bee": { "light": "light", "dark": "dark" },
      "violet": { "light": "violet-light", "dark": "violet-dark" }
    }
  },
  "tokens": {
    "spacing": {
      "$type": "dimension",
      "$description": "Base spacing values exposed to TypeScript consumers.",
      "0": { "$value": { "value": 0, "unit": "px" } },
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "2.5": { "$value": { "value": 10, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "5": { "$value": { "value": 20, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "10": { "$value": { "value": 40, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } },
      "16": { "$value": { "value": 64, "unit": "px" } }
    },
    "radius": {
      "$type": "dimension",
      "$description": "Corner-radius scale.",
      "xs": { "$value": { "value": 4, "unit": "px" } },
      "sm": { "$value": { "value": 6, "unit": "px" } },
      "md": { "$value": { "value": 10, "unit": "px" } },
      "lg": { "$value": { "value": 14, "unit": "px" } },
      "xl": { "$value": { "value": 18, "unit": "px" } },
      "2xl": { "$value": { "value": 24, "unit": "px" } },
      "full": { "$value": { "value": 9999, "unit": "px" } }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "$description": "Platform font-family intent.",
      "sans": { "$value": "system" }
    },
    "fontSize": {
      "$type": "dimension",
      "$description": "Semantic typography sizes.",
      "caption": { "$value": { "value": 12, "unit": "px" } },
      "label": { "$value": { "value": 14, "unit": "px" } },
      "body": { "$value": { "value": 16, "unit": "px" } },
      "heading": { "$value": { "value": 18, "unit": "px" } },
      "title": { "$value": { "value": 24, "unit": "px" } },
      "display": { "$value": { "value": 32, "unit": "px" } }
    },
    "lineHeight": {
      "$type": "dimension",
      "$description": "Line heights paired with semantic typography sizes.",
      "caption": { "$value": { "value": 16, "unit": "px" } },
      "label": { "$value": { "value": 20, "unit": "px" } },
      "body": { "$value": { "value": 24, "unit": "px" } },
      "heading": { "$value": { "value": 24, "unit": "px" } },
      "title": { "$value": { "value": 32, "unit": "px" } },
      "display": { "$value": { "value": 40, "unit": "px" } }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "$description": "Supported typography weights.",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "$description": "Canonical tracking values in px. CSS em output is derived using metadata.cssPixelReference.",
      "normal": { "$value": { "value": 0, "unit": "px" } },
      "tight": { "$value": { "value": -0.2, "unit": "px" } }
    },
    "controlSize": {
      "$type": "dimension",
      "$description": "Control geometry and minimum touch target.",
      "compact": { "$value": { "value": 36, "unit": "px" } },
      "default": { "$value": { "value": 44, "unit": "px" } },
      "large": { "$value": { "value": 48, "unit": "px" } },
      "icon": { "$value": { "value": 44, "unit": "px" } },
      "touchTarget": { "$value": { "value": 44, "unit": "px" } }
    },
    "iconSize": {
      "$type": "dimension",
      "$description": "Icon geometry independent of icon library.",
      "xs": { "$value": { "value": 12, "unit": "px" } },
      "sm": { "$value": { "value": 16, "unit": "px" } },
      "md": { "$value": { "value": 20, "unit": "px" } },
      "lg": { "$value": { "value": 24, "unit": "px" } }
    },
    "avatarSize": {
      "$type": "dimension",
      "$description": "Avatar geometry.",
      "sm": { "$value": { "value": 32, "unit": "px" } },
      "md": { "$value": { "value": 40, "unit": "px" } },
      "lg": { "$value": { "value": 48, "unit": "px" } },
      "xl": { "$value": { "value": 64, "unit": "px" } }
    },
    "contentWidth": {
      "$type": "dimension",
      "$description": "Semantic maximum content widths.",
      "form": { "$value": { "value": 512, "unit": "px" } },
      "reading": { "$value": { "value": 704, "unit": "px" } },
      "page": { "$value": { "value": 1152, "unit": "px" } },
      "dialog": { "$value": { "value": 512, "unit": "px" } }
    },
    "elevation": {
      "$type": "shadow",
      "$description": "Cross-platform layering intent with accepted web and native representations.",
      "flat": {
        "$value": { "web": "none", "nativeElevation": 0 },
        "$extensions": { "com.beeui.cssValue": "0 0 #0000" }
      },
      "raised": {
        "$value": {
          "web": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
          "nativeElevation": 2
        }
      },
      "overlay": {
        "$value": { "web": "0 16px 40px rgb(16 24 40 / 0.18)", "nativeElevation": 8 }
      }
    },
    "motionDuration": {
      "$type": "duration",
      "$description": "Motion durations; tokens do not make animation mandatory.",
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "normal": { "$value": { "value": 200, "unit": "ms" } },
      "slow": { "$value": { "value": 320, "unit": "ms" } }
    },
    "motionEasing": {
      "$type": "cubicBezier",
      "$description": "Supported CSS easing curves.",
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "emphasized": { "$value": "cubic-bezier(0.2, 0, 0, 1.2)" }
    },
    "focusRing": {
      "$type": "composite",
      "$description": "Cross-platform focus-indicator contract.",
      "$value": {
        "width": { "value": 2, "unit": "px" },
        "offset": { "value": 2, "unit": "px" },
        "colorToken": "focus-ring",
        "webVisibility": "focus-visible",
        "nativeVisibility": "platform-focus"
      }
    }
  },
  "semanticColors": {
    "$type": "color",
    "$description": "Stable semantic vocabulary implemented by every runtime theme.",
    "background": { "$description": "Application background." },
    "foreground": { "$description": "Primary content foreground." },
    "surface": { "$description": "Default content surface." },
    "surface-muted": { "$description": "Muted content surface." },
    "surface-raised": { "$description": "Raised content surface." },
    "muted": { "$description": "Muted fill." },
    "muted-foreground": { "$description": "Readable secondary foreground." },
    "subtle-foreground": { "$description": "Low-emphasis foreground." },
    "primary": { "$description": "Primary action fill." },
    "primary-foreground": { "$description": "Primary action foreground." },
    "primary-hover": { "$description": "Primary action hover fill." },
    "primary-pressed": { "$description": "Primary action pressed fill." },
    "secondary": { "$description": "Secondary action fill." },
    "secondary-foreground": { "$description": "Secondary action foreground." },
    "secondary-hover": { "$description": "Secondary action hover fill." },
    "secondary-pressed": { "$description": "Secondary action pressed fill." },
    "destructive": { "$description": "Destructive action or invalid boundary." },
    "destructive-foreground": { "$description": "Destructive action foreground." },
    "destructive-hover": { "$description": "Destructive action hover fill." },
    "destructive-pressed": { "$description": "Destructive action pressed fill." },
    "success": { "$description": "Success feedback fill." },
    "success-foreground": { "$description": "Success feedback foreground." },
    "warning": { "$description": "Warning feedback fill." },
    "warning-foreground": { "$description": "Warning feedback foreground." },
    "info": { "$description": "Informational feedback fill." },
    "info-foreground": { "$description": "Informational feedback foreground." },
    "border": { "$description": "Subtle structural boundary." },
    "border-strong": { "$description": "Strong structural boundary." },
    "control-border": { "$description": "Interactive input-like control boundary." },
    "input": { "$description": "Input surface." },
    "focus-ring": { "$description": "Focus indicator." },
    "disabled": { "$description": "Disabled surface." },
    "disabled-foreground": { "$description": "Disabled foreground." },
    "overlay": { "$description": "Scrim overlay." }
  },
  "themes": {
    "light": {
      "$description": "Bee light runtime theme.",
      "colors": {
        "background": { "$value": "#ffffff" }, "foreground": { "$value": "#101828" },
        "surface": { "$value": "#ffffff" }, "surface-muted": { "$value": "#f9fafb" }, "surface-raised": { "$value": "#ffffff" },
        "muted": { "$value": "#f2f4f7" }, "muted-foreground": { "$value": "#667085" }, "subtle-foreground": { "$value": "#98a2b3" },
        "primary": { "$value": "#f59e0b" }, "primary-foreground": { "$value": "#1f2937" }, "primary-hover": { "$value": "#e58a05" }, "primary-pressed": { "$value": "#d97706" },
        "secondary": { "$value": "#111827" }, "secondary-foreground": { "$value": "#ffffff" }, "secondary-hover": { "$value": "#1f2937" }, "secondary-pressed": { "$value": "#374151" },
        "destructive": { "$value": "#dc2626" }, "destructive-foreground": { "$value": "#ffffff" }, "destructive-hover": { "$value": "#b91c1c" }, "destructive-pressed": { "$value": "#991b1b" },
        "success": { "$value": "#16a34a" }, "success-foreground": { "$value": "#052e16" }, "warning": { "$value": "#d97706" }, "warning-foreground": { "$value": "#1f2937" }, "info": { "$value": "#2563eb" }, "info-foreground": { "$value": "#ffffff" },
        "border": { "$value": "#eaecf0" }, "border-strong": { "$value": "#d0d5dd" }, "control-border": { "$value": "#8590a2" }, "input": { "$value": "#ffffff" }, "focus-ring": { "$value": "#b45309" },
        "disabled": { "$value": "#f2f4f7" }, "disabled-foreground": { "$value": "#98a2b3" }, "overlay": { "$value": "#00000080" }
      }
    },
    "dark": {
      "$description": "Bee dark runtime theme.",
      "colors": {
        "background": { "$value": "#0b0f14" }, "foreground": { "$value": "#f2f4f7" },
        "surface": { "$value": "#121820" }, "surface-muted": { "$value": "#171e27" }, "surface-raised": { "$value": "#1b2430" },
        "muted": { "$value": "#202936" }, "muted-foreground": { "$value": "#a4adba" }, "subtle-foreground": { "$value": "#7d8796" },
        "primary": { "$value": "#fbbf24" }, "primary-foreground": { "$value": "#1f2937" }, "primary-hover": { "$value": "#f59e0b" }, "primary-pressed": { "$value": "#d97706" },
        "secondary": { "$value": "#e5e7eb" }, "secondary-foreground": { "$value": "#111827" }, "secondary-hover": { "$value": "#d1d5db" }, "secondary-pressed": { "$value": "#9ca3af" },
        "destructive": { "$value": "#f87171" }, "destructive-foreground": { "$value": "#1f0a0a" }, "destructive-hover": { "$value": "#fb7185" }, "destructive-pressed": { "$value": "#f43f5e" },
        "success": { "$value": "#4ade80" }, "success-foreground": { "$value": "#052e16" }, "warning": { "$value": "#fbbf24" }, "warning-foreground": { "$value": "#1f2937" }, "info": { "$value": "#60a5fa" }, "info-foreground": { "$value": "#0b1f3a" },
        "border": { "$value": "#273241" }, "border-strong": { "$value": "#3a4656" }, "control-border": { "$value": "#667085" }, "input": { "$value": "#121820" }, "focus-ring": { "$value": "#fbbf24" },
        "disabled": { "$value": "#202936" }, "disabled-foreground": { "$value": "#667085" }, "overlay": { "$value": "#00000099" }
      }
    },
    "violet-light": {
      "$description": "Violet light runtime theme.",
      "colors": {
        "background": { "$value": "#ffffff" }, "foreground": { "$value": "#171328" },
        "surface": { "$value": "#ffffff" }, "surface-muted": { "$value": "#faf8ff" }, "surface-raised": { "$value": "#ffffff" },
        "muted": { "$value": "#f3f0ff" }, "muted-foreground": { "$value": "#625b71" }, "subtle-foreground": { "$value": "#7d748d" },
        "primary": { "$value": "#7c3aed" }, "primary-foreground": { "$value": "#ffffff" }, "primary-hover": { "$value": "#6d28d9" }, "primary-pressed": { "$value": "#5b21b6" },
        "secondary": { "$value": "#2e1065" }, "secondary-foreground": { "$value": "#ffffff" }, "secondary-hover": { "$value": "#3b0764" }, "secondary-pressed": { "$value": "#4c1d95" },
        "destructive": { "$value": "#dc2626" }, "destructive-foreground": { "$value": "#ffffff" }, "destructive-hover": { "$value": "#b91c1c" }, "destructive-pressed": { "$value": "#991b1b" },
        "success": { "$value": "#15803d" }, "success-foreground": { "$value": "#ffffff" }, "warning": { "$value": "#b45309" }, "warning-foreground": { "$value": "#ffffff" }, "info": { "$value": "#1d4ed8" }, "info-foreground": { "$value": "#ffffff" },
        "border": { "$value": "#e8e1f5" }, "border-strong": { "$value": "#cec4df" }, "control-border": { "$value": "#9488a4" }, "input": { "$value": "#ffffff" }, "focus-ring": { "$value": "#7c3aed" },
        "disabled": { "$value": "#f3f0f5" }, "disabled-foreground": { "$value": "#8b8199" }, "overlay": { "$value": "#100c1c80" }
      }
    },
    "violet-dark": {
      "$description": "Violet dark runtime theme.",
      "colors": {
        "background": { "$value": "#100c1c" }, "foreground": { "$value": "#f6f2ff" },
        "surface": { "$value": "#171126" }, "surface-muted": { "$value": "#1e1631" }, "surface-raised": { "$value": "#261b3d" },
        "muted": { "$value": "#2d2147" }, "muted-foreground": { "$value": "#b8abc9" }, "subtle-foreground": { "$value": "#998ba9" },
        "primary": { "$value": "#a78bfa" }, "primary-foreground": { "$value": "#180b2d" }, "primary-hover": { "$value": "#c4b5fd" }, "primary-pressed": { "$value": "#9066f4" },
        "secondary": { "$value": "#ede9fe" }, "secondary-foreground": { "$value": "#1f1235" }, "secondary-hover": { "$value": "#ddd6fe" }, "secondary-pressed": { "$value": "#c4b5fd" },
        "destructive": { "$value": "#f87171" }, "destructive-foreground": { "$value": "#1f0a0a" }, "destructive-hover": { "$value": "#fb7185" }, "destructive-pressed": { "$value": "#f43f5e" },
        "success": { "$value": "#4ade80" }, "success-foreground": { "$value": "#052e16" }, "warning": { "$value": "#fbbf24" }, "warning-foreground": { "$value": "#1f2937" }, "info": { "$value": "#60a5fa" }, "info-foreground": { "$value": "#0b1f3a" },
        "border": { "$value": "#382b50" }, "border-strong": { "$value": "#514066" }, "control-border": { "$value": "#786d87" }, "input": { "$value": "#171126" }, "focus-ring": { "$value": "#c4b5fd" },
        "disabled": { "$value": "#2d2147" }, "disabled-foreground": { "$value": "#786d87" }, "overlay": { "$value": "#000000a3" }
      }
    }
  }
}
