{
  "name": "@beemvp/beeui-tokens",
  "version": "0.1.0",
  "description": "BeeUI's design-token system: semantic color/spacing/typography/motion contracts and the canonical Uniwind/Tailwind theme CSS.",
  "license": "MIT",
  "author": {
    "name": "Trần Đức Lân",
    "email": "lantranduc@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beobungbu/BeeUI.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/beobungbu/BeeUI#readme",
  "bugs": {
    "url": "https://github.com/beobungbu/BeeUI/issues"
  },
  "keywords": [
    "beeui",
    "design-tokens",
    "tailwindcss",
    "uniwind",
    "theme",
    "react-native"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/module/index.d.ts",
  "files": [
    "dist",
    "src",
    "tokens.json"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./dist/module/index.js",
      "import": {
        "types": "./dist/typescript/module/index.d.ts",
        "default": "./dist/module/index.js"
      },
      "require": {
        "types": "./dist/typescript/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      },
      "browser": "./dist/module/index.js",
      "default": "./dist/module/index.js"
    },
    "./motion-runtime": {
      "source": "./src/motion-runtime.ts",
      "react-native": "./dist/module/motion-runtime.js",
      "import": {
        "types": "./dist/typescript/module/motion-runtime.d.ts",
        "default": "./dist/module/motion-runtime.js"
      },
      "require": {
        "types": "./dist/typescript/commonjs/motion-runtime.d.ts",
        "default": "./dist/commonjs/motion-runtime.js"
      },
      "browser": "./dist/module/motion-runtime.js",
      "default": "./dist/module/motion-runtime.js"
    },
    "./theme.css": "./src/theme.css",
    "./tokens.json": "./tokens.json",
    "./tokens.resolver.json": "./src/tokens.resolver.json",
    "./lifecycle.json": "./src/lifecycle.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node ../../scripts/generate-tokens.mjs",
    "check": "node ../../scripts/generate-tokens.mjs --check",
    "build": "bob build",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
