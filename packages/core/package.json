{
  "name": "@beeui/core",
  "version": "0.1.0",
  "description": "Engine-neutral utilities (class-name merging, anchored-overlay geometry) shared by @beeui/ui. No React, React Native, or Expo dependency.",
  "license": "MIT",
  "author": {
    "name": "Trần Đức Lân",
    "email": "lantranduc@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beobungbu/BeeUI.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/beobungbu/BeeUI#readme",
  "bugs": {
    "url": "https://github.com/beobungbu/BeeUI/issues"
  },
  "keywords": [
    "beeui",
    "react-native",
    "react",
    "design-system",
    "utilities"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/module/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./dist/module/index.js",
      "import": {
        "types": "./dist/typescript/module/index.d.ts",
        "default": "./dist/module/index.js"
      },
      "require": {
        "types": "./dist/typescript/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      },
      "browser": "./dist/module/index.js",
      "default": "./dist/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bob build",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  }
}
