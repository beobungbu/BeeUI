{
  "name": "beeui-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Trần Đức Lân",
    "email": "lantranduc@gmail.com"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "24.13.1"
  },
  "scripts": {
    "showcase": "pnpm --filter @beeui/showcase start",
    "ios": "pnpm --filter @beeui/showcase ios",
    "android": "pnpm --filter @beeui/showcase android",
    "web": "pnpm --filter @beeui/showcase web",
    "docs": "pnpm --filter @beeui/docs dev",
    "docs:build": "pnpm --filter @beeui/docs build",
    "hygiene:check": "node ./scripts/check-repo-hygiene.mjs",
    "tokens:generate": "node ./scripts/generate-tokens.mjs",
    "tokens:check": "node ./scripts/generate-tokens.mjs --check && node ./scripts/check-token-removals.mjs",
    "tokens:consumption-check": "node ./scripts/check-semantic-token-consumption.mjs",
    "tokens:test": "node --test ./scripts/__tests__/generate-tokens.test.mjs ./scripts/__tests__/responsive-layout-tokens.test.mjs ./scripts/__tests__/theme-overrides-tokens.test.mjs ./scripts/__tests__/density-tokens.test.mjs ./scripts/__tests__/token-lifecycle.test.mjs ./scripts/__tests__/token-removal-guard.test.mjs ./scripts/__tests__/check-semantic-token-consumption.test.mjs",
    "compat:check": "node ./scripts/check-compatibility-matrix.mjs",
    "compat:test": "node --test ./scripts/__tests__/check-compatibility-matrix.test.mjs",
    "ui-exports:generate": "node ./scripts/generate-ui-exports.mjs",
    "ui-exports:check": "node ./scripts/generate-ui-exports.mjs --check",
    "ui-exports:test": "pnpm build && node --test ./scripts/__tests__/generate-ui-exports.test.mjs ./scripts/__tests__/verify-ui-export-map.test.mjs",
    "llms:generate": "node ./scripts/generate-llms-txt.mjs",
    "llms:check": "node ./scripts/generate-llms-txt.mjs --check",
    "llms:test": "node --test ./scripts/__tests__/generate-llms-txt.test.mjs",
    "ai-contract:check": "node ./scripts/check-ai-agent-contract.mjs",
    "ai-contract:test": "node --test ./scripts/__tests__/ai-agent-contract.test.mjs",
    "docs:contract:generate": "node ./scripts/generate-component-reference.mjs",
    "docs:contract:check": "node ./scripts/generate-component-reference.mjs --check",
    "docs:contract:test": "node --test ./scripts/__tests__/component-reference.test.mjs",
    "docs:examples:check": "node ./scripts/check-doc-examples.mjs",
    "docs:examples:test": "node --test ./scripts/__tests__/doc-examples.test.mjs",
    "docs:patterns:generate": "node ./scripts/generate-pattern-library.mjs",
    "docs:patterns:check": "node ./scripts/generate-pattern-library.mjs --check",
    "docs:patterns:test": "node --test ./scripts/__tests__/pattern-library.test.mjs",
    "release-ruleset:check": "node ./scripts/check-release-ruleset.mjs",
    "release-ruleset:test": "node --test ./scripts/__tests__/release-ruleset-contract.test.mjs",
    "bench": "node ./scripts/benchmark/cli.mjs",
    "bench:web": "node ./scripts/benchmark/cli.mjs --platform web",
    "bench:native": "node ./scripts/benchmark/cli.mjs --platform native",
    "bench:test": "node --test ./scripts/__tests__/benchmark-statistics.test.mjs ./scripts/__tests__/benchmark-sampler.test.mjs ./scripts/__tests__/benchmark-registry.test.mjs ./scripts/__tests__/benchmark-runner.test.mjs ./scripts/__tests__/footprint-analysis.test.mjs ./scripts/__tests__/budget-evaluator.test.mjs",
    "bench:components": "pnpm --filter @beeui/showcase bench && node ./scripts/benchmark/collect-component-results.mjs",
    "bench:footprint": "pnpm build && node ./scripts/benchmark/footprint.mjs",
    "bench:budget": "pnpm bench:footprint && node ./scripts/benchmark/budget-check.mjs",
    "build": "pnpm --filter './packages/*' run build",
    "typecheck": "pnpm hygiene:check && pnpm tokens:check && pnpm tokens:consumption-check && pnpm compat:check && pnpm ui-exports:check && pnpm release-ruleset:check && pnpm llms:check && pnpm ai-contract:check && pnpm docs:contract:check && pnpm docs:examples:check && pnpm docs:patterns:check && pnpm build && pnpm -r --if-present typecheck",
    "test": "pnpm tokens:test && pnpm compat:test && pnpm ui-exports:test && pnpm release-ruleset:test && pnpm llms:test && pnpm ai-contract:test && pnpm docs:contract:test && pnpm docs:examples:test && pnpm docs:patterns:test && pnpm bench:test && pnpm --filter @beeui/showcase test && pnpm registry:verify && pnpm registry:test",
    "check": "pnpm typecheck && pnpm test",
    "release:verify": "node ./scripts/verify-release.mjs",
    "beeui": "node ./scripts/beeui.mjs",
    "registry:verify": "node ./scripts/verify-registry.mjs",
    "registry:test": "node --test ./scripts/__tests__/beeui.test.mjs",
    "cli:smoke": "pnpm --filter @beeui/cli run build && pnpm --filter @beeui/cli run smoke",
    "tokens:migration-report": "node ./scripts/generate-token-migration-report.mjs"
  },
  "devDependencies": {
    "@hyperjump/json-schema": "1.17.8",
    "@types/react": "^19.2.0",
    "esbuild": "0.28.2",
    "react-native-builder-bob": "0.43.0",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
