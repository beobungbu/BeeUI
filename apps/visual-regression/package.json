{
  "name": "@beeui/visual-regression",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build:web": "expo export --platform web --output-dir dist-web",
    "serve:web": "node ./scripts/serve.mjs",
    "test": "pnpm build:web && playwright test",
    "test:update": "pnpm build:web && playwright test --update-snapshots",
    "test:a11y": "pnpm build:web && playwright test --project=a11y-audit --project=a11y-gate-regression",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@beeui/tokens": "workspace:*",
    "@beeui/ui": "workspace:*",
    "@expo/metro-runtime": "~57.0.12",
    "expo": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "0.21.0",
    "tailwindcss": "4.3.3",
    "uniwind": "1.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.1"
  }
}
