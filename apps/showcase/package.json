{
  "name": "@beeui/showcase",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@beeui/tokens": "workspace:*",
    "@beeui/ui": "workspace:*",
    "@expo/metro-runtime": "~57.0.12",
    "@react-native-community/datetimepicker": "~9.1.0",
    "expo": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-teleport": "~1.1.13",
    "react-native-web": "0.21.0",
    "tailwindcss": "4.3.3",
    "uniwind": "1.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "jest": "29.7.0",
    "jest-expo": "57.0.4"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@beeui/core$": "<rootDir>/../../packages/core/src/index.ts",
      "^@beeui/tokens$": "<rootDir>/../../packages/tokens/src/index.ts",
      "^@beeui/ui$": "<rootDir>/../../packages/ui/src/index.ts",
      "^uniwind$": "<rootDir>/__mocks__/uniwind.ts"
    },
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ]
  }
}
