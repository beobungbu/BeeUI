---
/// <reference types="@astrojs/starlight/locals" />
// Extends Starlight's default `Head` component with a `data-pagefind-filter` meta tag, which
// puts a `section` facet in the built Pagefind index (#466: Components / Patterns / Guides /
// Learn / Reference / Troubleshooting / Examples).
//
// This delivers the metadata half of #466's "search result grouping/metadata" only. Verified
// present and queryable in the built index (`pagefind.filters()` returns all eight sections and
// filtered searches work), but Starlight 0.41 ships its own search modal rather than Pagefind's
// default UI, and that modal renders no filter control — so a reader cannot yet narrow or group
// results by section. Reader-visible grouping needs a `Search` component override and is
// tracked in #500; do not read this file as evidence that grouping is live.
//
// This runs for every page from one place, driven only by the route slug — it does not require
// hand-editing any generated page (components/*, patterns/*, reference/* are all generated by
// scripts under scripts/ and must stay untouched).
//
// The reference above registers `Astro.locals.starlightRoute`'s type; nothing else in this
// project touches Starlight's locals, so the ambient declaration was never wired in project-wide.
import Default from '@astrojs/starlight/components/Head.astro';

const { id } = Astro.locals.starlightRoute;

// Ordered by specificity: a longer/more specific prefix must be checked before a shorter one
// that would otherwise also match (guides/troubleshooting before guides/). A section's own hub
// page (slug exactly "guides", with no trailing segment) must match too, so comparison is done
// against `${slug}/` rather than `slug` directly.
const SECTION_RULES: Array<[string, string]> = [
  ['guides/troubleshooting/', 'Troubleshooting'],
  ['components/', 'Components'],
  ['patterns/', 'Patterns'],
  ['learn/', 'Learn'],
  ['guides/', 'Guides'],
  ['ai/', 'Guides'],
  ['responsive/', 'Guides'],
  ['start/', 'Start'],
  ['showcase/', 'Examples'],
  ['reference-app/', 'Examples'],
  ['reference/', 'Reference'],
  ['registry/', 'Reference'],
  ['compatibility/', 'Reference'],
  ['theming/', 'Guides'],
  ['performance/', 'Guides'],
  ['release-security/', 'Reference'],
  ['accessibility/', 'Guides'],
  ['architecture/', 'Learn'],
];

function sectionFor(slug: string): string | undefined {
  const withSlash = `${slug}/`;
  for (const [prefix, section] of SECTION_RULES) {
    if (withSlash.startsWith(prefix)) return section;
  }
  return undefined;
}

const section = sectionFor(id);
---

<Default {...Astro.props}><slot /></Default>
{section && <meta data-pagefind-filter="section[content]" content={section} />}
