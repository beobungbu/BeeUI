---
// Renders the current release status as a Starlight callout, from the pre-rendered narrative in
// apps/docs/public/release-state.json (generated by scripts/generate-docs-foundation.mjs from the
// shared renderer, scripts/release-status-lib.mjs, fed by docs/registry-observation.json).
//
// This component owns rendering only — it never derives the state itself, so the human docs site,
// README's generated block and the llms.txt family can never independently state a different
// publication truth for the same commit.
//
// Rendered by the `PageTitle` override (ReleaseStatusPageTitle.astro) on pages whose frontmatter
// sets `releaseStatus: true`; see apps/docs/src/content.config.ts.
import { Icon } from '@astrojs/starlight/components';

import { RELEASE_STATE } from '../lib/release-state';

const calloutIcon = RELEASE_STATE.published
  ? 'approve-check-circle'
  : RELEASE_STATE.state === 'unpublished'
    ? 'information'
    : 'warning';
---

<aside class="release-status-callout starlight-aside" data-release-state={RELEASE_STATE.state}>
	<p class="starlight-aside__title">
		<Icon name={calloutIcon} class="starlight-aside__icon" />
		Release status
	</p>
	<div class="starlight-aside__content">
		<p>{RELEASE_STATE.statusText}</p>
	</div>
</aside>

<style>
	.release-status-callout {
		margin-block: 1rem 1.5rem;
	}
</style>
